# Node development/build output
node_modules/
dist/
.npm-cache/
*.tgz

# AutoGit personal data (never distribute keys)
/data/
.autogit-data/

# Generated release evidence (kept locally, regenerated by npm run verify)
/artifacts/release-*.json
/artifacts/npm-pack-*.json
/artifacts/verification-*.txt
/artifacts/test-results-*.txt
/artifacts/typecheck-*.txt
/artifacts/npm-ci-*.txt
/artifacts/cli-smoke-*.txt

# Isolated tests and local task state
.claude-tmp/
/.claude/scheduled_tasks.lock

# Local secrets; not a substitute for checking staged contents
.env
.env.*
!.env.example

.DS_Store
Thumbs.db
